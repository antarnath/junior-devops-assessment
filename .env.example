# Copy to .env and fill in real values locally. NEVER commit .env.
# Every value here is a local-development placeholder only.

# --- Application ---
APP_ENV=local
APP_NAME=apex-operations-api
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database ---
POSTGRES_USER=apex
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=apex_operations

# --- Secrets ---
# Supplied by a secret manager in any real deployment. Placeholder here.
API_KEY=replace-with-real-secret-from-vault
JWT_SIGNING_KEY=replace-with-real-secret-from-vault

# --- Observability ---
PROMETHEUS_ENABLED=true
